# Plantilla systemd del OCR de UNA cama (ADR-023). Instancia %i = cama_id:
#   sudo systemctl enable --now ocr-publicar@cama-09
#
# ANTES de enable --now (runbook completo en ocr/README.md, seccion Jetson):
#   0. MATAR el nohup+while manual si sigue vivo (pgrep -af 'while true|ocr.publicar'):
#      primero el bash del while (si no, relanza al python), luego el python.
#      Dos publicadores de la misma cama = takeover MQTT con flapping (ADR-022)
#      y dos lectores del mismo V4L2 = EBUSY.
#   1. Verificar rutas y ajustar ESTE archivo si difieren (systemd no expande
#      variables en WorkingDirectory ni en el ejecutable):
#        ls /home/jetson/MonitoreoPediatria/ocr/publicar.py
#        conda run -n ocr-monitoreo which python
#      (miniforge3 es la ruta REAL de esta Jetson — nota de campo del 15-sep
#      en PENDIENTES; el brief original decia miniconda3.)
#   2. Preflight (valida python del env, imports, permisos de video del usuario
#      jetson —grupo video— y la identidad de la capturadora):
#        cd /home/jetson/MonitoreoPediatria && \
#          /home/jetson/miniforge3/envs/ocr-monitoreo/bin/python -m ocr.publicar --listar-dispositivos
#   3. sudo mkdir -p /etc/monitoreo && crear /etc/monitoreo/cama-09.conf
#      (ejemplo: docs/ito2/cama-09.conf.ejemplo; lo lee root, no el usuario).
#   4. Instalar esta unit y recargar el manager:
#      sudo cp ocr/ocr-publicar@.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#
# Para DETENER: systemctl stop (un kill -9 ya NO detiene: systemd revive).

[Unit]
Description=OCR de vitales de la cama %i (ADR-023)
After=network-online.target
Wants=network-online.target
# El OCR SALE a proposito ante frame negro (nunca un frame viejo, ADR-013/
# fuente.py). Con RestartSec=5 el limite por defecto ya es inalcanzable
# (max. 3 arranques por ventana de 10 s frente a un burst de 5); =0 lo hace
# EXPLICITO y blinda contra un futuro RestartSec mas corto: este supervisor
# jamas se rinde. (%i, no %I: %I des-escaparia la instancia.)
StartLimitIntervalSec=0

[Service]
User=jetson
WorkingDirectory=/home/jetson/MonitoreoPediatria
# Sin prefijo '-' A PROPOSITO: un typo de instancia (cama-9) debe flapear
# visible en journalctl, no arrancar con variables vacias.
EnvironmentFile=/etc/monitoreo/%i.conf
# Los prints del OCR no llevan flush: sin esto, journald quedaria mudo.
Environment=PYTHONUNBUFFERED=1
# Guard-rail: un ${VAR} ausente en el conf se expande a argumento VACIO (no
# se omite); esto lo convierte en fallo de arranque explicito. ($$ = $ literal
# para que lo evalue el shell con el entorno ya cargado.)
ExecStartPre=/bin/sh -c 'test -n "$${DISPOSITIVO_OCR}" && test -n "$${BROKER}" && test -n "$${DEVICE_ID}"'
ExecStart=/home/jetson/miniforge3/envs/ocr-monitoreo/bin/python -m ocr.publicar --fuente capturadora --dispositivo ${DISPOSITIVO_OCR} --cama-id %i --device-id ${DEVICE_ID} --broker ${BROKER}
Restart=always
RestartSec=5
# argparse sale con 2 ante flags/valores malformados: un typo de config queda
# PARADO y visible, no flapeando eterno (exit 1 legitimo si reintenta).
RestartPreventExitStatus=2
# Sin MemoryMax por ahora: el techo del OCR (onnxruntime) se fija tras medirlo
# en banco — decision, no olvido (la ingesta del servidor si lo lleva).

[Install]
WantedBy=multi-user.target
